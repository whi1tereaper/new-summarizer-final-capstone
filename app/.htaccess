<IfModule mod_rewrite.c>
    RewriteEngine On

    # block sensitive folders if Apache reaches this level
    RewriteRule ^(src|logs|uploads)/ - [F,L]

    # hand normal app traffic to the public front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ public/index.php [L]
</IfModule>
