# Application
APP_NAME="AI Article Summarizer"
APP_ENV=development
APP_DEBUG=true
APP_URL="http://localhost/ai-summarizer-123%20-%20quality%20upg/app/public"
SESSION_NAME="LIGHT_SESSID"
# Local XAMPP configuration.
TRUSTED_PROXIES=

# Database
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_summarizer
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4
DB_SSL_ENABLED=false

# Python worker
LOCAL_PYTHON_BIN="python"
LOCAL_PYTHON_SCRIPT=python-engine/local_cli.py
LOCAL_PYTHON_TIMEOUT=180
NLTK_DATA=
TESSERACT_CMD=
POPPLER_PATH=
# Keep "legacy" until the replacement engine completes local acceptance testing.
SUMMARIZER_ENGINE_VERSION=legacy
# Opt-in until held-out article quality and compatibility review are accepted.
# When enabled, articles use recipe_article; other content uses legacy.
SUMMARIZER_AUTO_ARTICLE_ROUTING=false
SUMMARIZER_LOCAL_EMBEDDING_MODEL=storage/models/all-MiniLM-L6-v2

# Optional evidence-bounded language-model synthesis (off by default).
# User documents are sent only after an individual request opts in. The default endpoint is local Ollama.
SUMMARIZER_LLM_ENABLED=false
SUMMARIZER_LLM_PROVIDER=openai_compatible
SUMMARIZER_LLM_BASE_URL=http://127.0.0.1:11434/v1
SUMMARIZER_LLM_MODEL=
SUMMARIZER_LLM_API_KEY=
SUMMARIZER_LLM_ALLOW_REMOTE=false
SUMMARIZER_LLM_TIMEOUT_SECONDS=30
SUMMARIZER_LLM_MAX_OUTPUT_TOKENS=1200
SUMMARIZER_LLM_MAX_TOKEN_FIELD=max_tokens

# Storage
STORAGE_ROOT=storage
STORAGE_UPLOADS=storage/uploads
STORAGE_AUDIO=storage/audio
STORAGE_LOGS=storage/logs
STORAGE_TMP=storage/tmp

# Translation
TRANSLATION_PROVIDER=deep-translator
TRANSLATION_TARGET_LANG=tl

# Text-to-speech
TTS_MAX_CHARS=0
TTS_MAX_TEXT_LENGTH=0
TTS_REQUEST_TIMEOUT_SECONDS=600
TTS_OUTPUT_DIR=storage/audio
AUDIO_OUTPUT_DIR=storage/audio
AUDIO_PUBLIC_URL=tts_audio.php
PIPER_BIN=
PIPER_VOICE=en_US-lessac-medium
PIPER_MODEL_EN=
PIPER_MODEL_FIL=
PIPER_CONFIG_EN=
PIPER_CONFIG_FIL=
PIPER_CACHE_DIR=storage/audio
PIPER_DATA_DIR=python-engine/models/piper
PIPER_DOWNLOAD_TIMEOUT_SECONDS=0
PIPER_USE_CUDA=false

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@example.com
# Operator contact: blank uses the existing administrator-controlled SMTP_FROM address.
# Published as AI Summarizer System Administrator / Privacy Contact, not NEUST's DPO.
STUDENT_PRIVACY_CONTACT=
# Keep false until actual authority to process campus enrollment data is confirmed.
STUDENT_ENROLLMENT_AUTHORIZED=false
# A stable base64-encoded 32-byte secret. Generate once, protect and back up; rotation needs a migration.
STUDENT_NUMBER_SECRET=
# Generic input safety only; replace only after the campus confirms its actual formats.
STUDENT_NUMBER_PATTERN="~\A[A-Z0-9][A-Z0-9-]{3,39}\z~D"
STUDENT_CONCURRENT_SUMMARIES=2
NEUST_ENROLLMENT_URL=https://neust.edu.ph/enrollment-procedure-and-qualifications/
