%% LIGHT summarizer: role and use-case overview
%% Use four focused panels for printing. Guest access excludes standalone Nutshell and personal history.
flowchart LR
    guests["Guest visitor"]
    guests0("Provide text, URL, PDF or DOCX<br/>and choose summary settings")
    guests1("Generate a summary; inspect<br/>progress, retry or cancel")
    guests2("Read an authorized result;<br/>copy / export / reading helpers")
    guests3("Submit permitted rating<br/>and feedback comments")
    guests4("Register, sign in or<br/>request password recovery")
    registered["Registered account"]
    registered0("Use eligible summarization<br/>and reading workflows")
    registered1("View personal summary<br/>history and analytics")
    registered2("Maintain profile and<br/>saved preferences")
    registered3("Generate standalone Nutshell<br/>when account guards permit")
    registered4("Read permitted shared results<br/>and give feedback")
    administrators["Administrator"]
    administrators0("Use eligible ordinary<br/>account workflows")
    administrators1("Manage permitted user<br/>account operations")
    administrators2("Inspect audit history,<br/>system records and analytics")
    administrators3("Manage evaluation datasets,<br/>runs, assignments and reports")
    evaluators["Assigned evaluator"]
    evaluators0("Open an eligible review<br/>with its assignment token")
    evaluators1("Inspect source material<br/>and the assigned output")
    evaluators2("Submit the permitted<br/>assessment and ratings")
    guests --- guests0
    guests --- guests1
    guests --- guests2
    guests --- guests3
    guests --- guests4
    registered --- registered0
    registered --- registered1
    registered --- registered2
    registered --- registered3
    registered --- registered4
    administrators --- administrators0
    administrators --- administrators1
    administrators --- administrators2
    administrators --- administrators3
    evaluators --- evaluators0
    evaluators --- evaluators1
    evaluators --- evaluators2
    classDef process fill:#edf1f5,stroke:#222,color:#111;
    classDef store fill:#f6f6f6,stroke:#222,color:#111;
    classDef entity fill:#fff,stroke:#222,color:#111;
    class guests0,guests1,guests2,guests3,guests4,registered0,registered1,registered2,registered3,registered4,administrators0,administrators1,administrators2,administrators3,evaluators0,evaluators1,evaluators2 process;
    class guests,registered,administrators,evaluators entity;
